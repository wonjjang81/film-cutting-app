name = "film-cutting-app"
pages_build_output_dir = "dist"
compatibility_date = "2026-08-22"

[vars]
ALLOWED_ORIGIN = "https://film.example.com"
GOOGLE_OAUTH_CLIENT_ID = "YOUR_EXISTING_CONSTRUCTION_MANAGER_CLIENT_ID"
AUTH_REDIRECT_URI = "https://film.example.com/api/auth/callback"
AUTH_OWNER_EMAIL = "tubebluemoon@gmail.com"
# GOOGLE_OAUTH_CLIENT_SECRET is an encrypted Cloudflare secret. Do not commit it.

[[d1_databases]]
binding = "DB"
database_name = "film-cutting-library"
database_id = "YOUR_D1_DATABASE_ID"
